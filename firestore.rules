rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function isStudent(uid) {
      return signedIn() && request.auth.uid == uid && request.auth.token.role == 'student';
    }

    function isActiveStudent(uid) {
      return isStudent(uid)
        && get(/databases/$(database)/documents/students/$(uid)).data.active == true;
    }

    match /students/{uid} {
      allow read: if isTeacher() || isStudent(uid);
      allow write: if false;

      match /progress/{lessonId} {
        allow read: if isTeacher() || isActiveStudent(uid);
        allow create, update: if isActiveStudent(uid)
          && request.resource.data.lessonId == lessonId
          && request.resource.data.keys().hasOnly([
            'lessonId',
            'completed',
            'completedAt',
            'attempts',
            'lastPassedCount',
            'totalTests',
            'lastAttemptAt',
            'updatedAt',
            'currentStage',
            'practiceCompleted',
            'challengeCompleted',
            'miniCompleted',
            'practiceAttempts',
            'challengeAttempts',
            'miniAttempts'
          ]);
        allow delete: if false;
      }

      match /games/{gameId} {
        allow read: if isTeacher() || isActiveStudent(uid);
        allow create, update: if isActiveStudent(uid)
          && request.resource.data.gameId == gameId
          && request.resource.data.completed is bool
          && request.resource.data.attempts is number
          && request.resource.data.bestScore is number
          && request.resource.data.total is number
          && request.resource.data.lastScore is number
          && request.resource.data.keys().hasOnly([
            'gameId',
            'completed',
            'attempts',
            'bestScore',
            'total',
            'lastScore',
            'lastAttemptAt',
            'completedAt',
            'updatedAt'
          ]);
        allow delete: if false;
      }
    }

    match /presence/{uid} {
      allow read: if isTeacher() || isActiveStudent(uid);
      allow create, update: if isActiveStudent(uid)
        && request.resource.data.studentId == uid
        && request.resource.data.online is bool
        && request.resource.data.currentPath is string
        && (request.resource.data.currentLessonId == null || request.resource.data.currentLessonId is string)
        && request.resource.data.visibility in ['visible', 'hidden']
        && request.resource.data.keys().hasOnly([
          'studentId',
          'online',
          'currentPath',
          'currentLessonId',
          'visibility',
          'lastSeen'
        ]);
      allow delete: if false;
    }

    match /liveSessions/{uid} {
      allow read: if isTeacher() || isActiveStudent(uid);
      allow create, update: if isActiveStudent(uid)
        && request.resource.data.studentId == uid
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 100000
        && request.resource.data.status in ['coding', 'testing', 'active', 'idle']
        && request.resource.data.activePane in ['mission', 'code', 'result']
        && request.resource.data.previewPreset in ['fit', 'desktop', 'tablet', 'mobile']
        && request.resource.data.previewScrollY is number
        && request.resource.data.previewScrollY >= 0
        && request.resource.data.previewScrollY <= 1000000
        && request.resource.data.keys().hasOnly([
          'studentId',
          'lessonId',
          'weekId',
          'taskId',
          'code',
          'passedCount',
          'totalTests',
          'status',
          'lastAction',
          'activePane',
          'previewPreset',
          'previewScrollY',
          'previewUpdatedAt',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /liveClass/{documentId} {
      allow read: if isTeacher() || isActiveStudent(request.auth.uid);
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    match /liveClasses/{sessionId} {
      allow read: if isTeacher() || isActiveStudent(request.auth.uid);
      allow create, update: if isTeacher();
      allow delete: if false;

      match /private/{documentId} {
        allow read, create, update: if isTeacher();
        allow delete: if false;
      }

      match /viewers/{studentUid} {
        allow read: if isTeacher() || isActiveStudent(studentUid);
        allow create, update: if isActiveStudent(studentUid)
          && request.resource.data.studentId == studentUid
          && request.resource.data.online is bool
          && request.resource.data.keys().hasOnly([
            'studentId',
            'joinedAt',
            'lastSeen',
            'online'
          ]);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
