rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function isStudent(uid) {
      return signedIn() && request.auth.uid == uid && request.auth.token.role == 'student';
    }

    function isActiveStudent(uid) {
      return isStudent(uid)
        && get(/databases/$(database)/documents/students/$(uid)).data.active == true;
    }

    match /students/{uid} {
      allow read: if isTeacher() || isStudent(uid);
      allow write: if false;

      match /progress/{lessonId} {
        allow read: if isTeacher() || isActiveStudent(uid);
        allow create, update: if isActiveStudent(uid)
          && request.resource.data.lessonId == lessonId
          && request.resource.data.keys().hasOnly([
            'lessonId',
            'completed',
            'completedAt',
            'attempts',
            'lastPassedCount',
            'totalTests',
            'lastAttemptAt',
            'updatedAt'
          ]);
        allow delete: if false;
      }
    }

    match /liveSessions/{uid} {
      allow read: if isTeacher() || isActiveStudent(uid);
      allow create, update: if isActiveStudent(uid)
        && request.resource.data.studentId == uid
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 100000
        && request.resource.data.status in ['coding', 'testing', 'active', 'idle']
        && request.resource.data.keys().hasOnly([
          'studentId',
          'lessonId',
          'weekId',
          'taskId',
          'code',
          'passedCount',
          'totalTests',
          'status',
          'lastAction',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
